# Postgres connection string. Local: postgresql://halves:halves@localhost:5432/halves
DATABASE_URL=
# Random string, 32+ chars. Guards /api/cron/recurring (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
# Public URL of the app, used in links. Local: http://localhost:3000
APP_URL=

# --- Email (password reset). Set ONE of the two options. With neither, links print to the dev server console.
# Shown as the sender. Must be an address on a domain you verified (Resend) or the SMTP mailbox itself.
MAIL_FROM=
# Option A: Resend (resend.com). Verify your domain there first.
RESEND_API_KEY=
# Option B: any SMTP mailbox, e.g. Hostinger email: smtp.hostinger.com, port 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
