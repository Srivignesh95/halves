{
  "name": "halves",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contrast": "python3 tools/contrast.py replica/design/tokens.json",
    "parity": "python3 tools/parity.py replica/features.csv",
    "sweep": "python3 tools/sweep.py . --config replica/brand.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx --env-file=.env src/db/reset.ts && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "next": "15.5.28",
    "postgres": "3.4.9",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "drizzle-kit": "0.31.11",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}